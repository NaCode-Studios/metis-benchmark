# Raw datasets are downloaded, never committed (licenses differ per dataset)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# --- Leak guard --------------------------------------------------------------
# The pilot harness (its runner and tests) is developed in a separate package
# and must never enter this repository's history; these paths are ignored as a
# redundant safeguard so an accidental copy can never be committed here. The
# engine modules (payload, composite_gp, multilingual) belong to the benchmark
# and are intentionally tracked, so reproduction stays self-contained.
scripts/run_pilot.py
tests/test_pilot_smoke.py
tests/test_pilot_verdict.py
